# Local validation only; on Render, set these in the named environment groups.

# gateway, workflows
RENDER_API_KEY=

# gateway, workflows. Locally: py-factory-db's external URL plus ?sslmode=verify-full&sslrootcert=system.
DATABASE_URL=

# gateway
PORT=3000
GITHUB_WEBHOOK_SECRET=
RENDER_WORKFLOW_SLUG=py-factory-workflows

# workflows
RENDER_WORKSPACE_ID=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
ANTHROPIC_API_KEY=
FACTORY_SANDBOX_GROUP_ID=

# Optional
LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=
LOGFIRE_PROJECT_URL=

# Setup operator only; never add to a service or environment group.
RENDER_ADMIN_API_KEY=

# Optional GitHub Enterprise Server API base URL.
GITHUB_API_URL=
