# Setup copies these values into the Render env groups render.yaml links; see docs/configuration.md.

# Both services: Render API key (the gateway starts runs; workflows manage sandboxes and cancel runs).
RENDER_API_KEY=

# Gateway.
PORT=3000
# Secret configured on the GitHub App's webhook.
GITHUB_WEBHOOK_SECRET=
# Slug of the factory-workflows service; runs start as <slug>/<task or flow>.
RENDER_WORKFLOW_SLUG=factory-workflows

# Workflows.
RENDER_WORKSPACE_ID=
# GitHub App credentials; the installation comes from each webhook.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Model provider key, for agents that run in the Workflows task. In-sandbox agents reach the model through the
# sandbox group's brokered credential, so this key never enters a sandbox.
ANTHROPIC_API_KEY=
# Optional: GitHub API base URL, for GitHub Enterprise Server.
GITHUB_API_URL=
