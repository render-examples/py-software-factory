# Copy this file to .env for local validation only. For Render, add each key to
# the environment group named below. Never commit the populated file.

# py-factory-gateway and py-factory-workflows. Prefer separately scoped keys when
# available: the gateway starts tasks; workflows manage tasks and sandboxes.
RENDER_API_KEY=

# py-factory-gateway and py-factory-workflows. On Render, the gateway gets this from
# the Blueprint's py-factory-db link, and py-factory-workflows gets it from
# `uv run setup-render --link-database --apply`. Locally, use py-factory-db's
# external URL with ?sslmode=verify-full&sslrootcert=system appended (and allow
# your IP on py-factory-db), or a local database such as postgresql:///postgres.
DATABASE_URL=

# py-factory-gateway.
PORT=3000
GITHUB_WEBHOOK_SECRET=
RENDER_WORKFLOW_SLUG=py-factory-workflows

# py-factory-workflows.
RENDER_WORKSPACE_ID=
GITHUB_APP_ID=
# PEM text, PEM text with escaped newlines, or base64-encoded PEM.
GITHUB_APP_PRIVATE_KEY=
ANTHROPIC_API_KEY=
# Sandbox group that owns the repository snapshots.
FACTORY_SANDBOX_GROUP_ID=

# Optional, py-factory-gateway and py-factory-workflows: a Logfire write token, a
# separate one for each service. Without it, nothing is sent to Logfire.
LOGFIRE_TOKEN=
# Optional: the Logfire environment name, such as demo or production.
LOGFIRE_ENVIRONMENT=
# Optional, py-factory-workflows: the Logfire project URL, such as
# https://logfire-us.pydantic.dev/acme/factory. Status comments then link each run's trace.
LOGFIRE_PROJECT_URL=

# Setup operator only. setup-render accepts this instead of RENDER_API_KEY for
# privileged group operations. Never add it to a service or environment group.
RENDER_ADMIN_API_KEY=

# Optional GitHub Enterprise Server API base URL.
GITHUB_API_URL=
