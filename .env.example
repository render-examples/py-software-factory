# Copy this file to .env for local validation only. For Render, add each key to
# the environment group named below. Never commit the populated file.

# factory-gateway and factory-workflows. Prefer separately scoped keys when
# available: the gateway starts tasks; workflows manage tasks and sandboxes.
RENDER_API_KEY=

# factory-gateway.
PORT=3000
GITHUB_WEBHOOK_SECRET=
RENDER_WORKFLOW_SLUG=factory-workflows

# factory-workflows.
RENDER_WORKSPACE_ID=
GITHUB_APP_ID=
# PEM text, PEM text with escaped newlines, or base64-encoded PEM.
GITHUB_APP_PRIVATE_KEY=
ANTHROPIC_API_KEY=
# Sandbox group that owns snapshots and the brokered provider credential.
FACTORY_SANDBOX_GROUP_ID=

# Setup operator only. setup-render accepts this instead of RENDER_API_KEY for
# privileged group operations. Never add it to a service or environment group.
RENDER_ADMIN_API_KEY=

# Optional GitHub Enterprise Server API base URL.
GITHUB_API_URL=
